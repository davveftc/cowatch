{
  "manifest_version": 3,
  "name": "CoWatch - Watch Party",
  "version": "1.2.0",
  "description": "Watch movies and shows together with friends on Netflix, YouTube, Disney+, Hulu, Amazon Prime, HBO Max, and more. Synchronized playback, voice/video chat, emoji reactions, and premium watch party features.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.youtube.com/*",
    "*://*.disneyplus.com/*",
    "*://*.hulu.com/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*",
    "*://*.max.com/*",
    "*://*.hbomax.com/*",
    "*://*.crunchyroll.com/*",
    "*://*.peacocktv.com/*",
    "*://*.paramountplus.com/*",
    "*://*.tv.apple.com/*",
    "*://*.tubitv.com/*",
    "*://*.tubi.tv/*",
    "*://*.pluto.tv/*",
    "*://*.twitch.tv/*",
    "*://*.dopebox.to/*",
    "*://*.plex.tv/*",
    "*://*.vudu.com/*",
    "*://*.vimeo.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hulu.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.com/*/dp/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.peacocktv.com/*",
        "*://*.paramountplus.com/*",
        "*://*.tv.apple.com/*",
        "*://*.tubitv.com/*",
        "*://*.tubi.tv/*",
        "*://*.pluto.tv/*",
        "*://*.twitch.tv/*",
        "*://*.dopebox.to/*",
        "*://*.plex.tv/*",
        "*://*.vudu.com/*",
        "*://*.vimeo.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CoWatch - Watch Party"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
