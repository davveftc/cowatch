{
  "manifest_version": 3,
  "name": "CoWatch - Watch Party for DopeBox",
  "version": "1.0.0",
  "description": "Watch movies and shows together with friends on DopeBox. Synchronized playback, real-time chat, and seamless watch parties.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://*.dopebox.to/*"],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.dopebox.to/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CoWatch - Watch Party"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
